{% extends "layout.twig" %}
{% block title %}Dashboard{% endblock %}
{% block content %}
<h3 class="mb-4">Tổng quan kho hàng</h3>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card p-3" style="background: linear-gradient(135deg,#4e73df,#3a5ecf);">
            <div class="small">Số nhà kho</div>
            <div class="fs-2 fw-bold">{{ totalWarehouses }}</div>
            <i class="fa-solid fa-building position-absolute top-0 end-0 m-3 opacity-50 fs-3"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3" style="background: linear-gradient(135deg,#1cc88a,#17a673);">
            <div class="small">Loại vật dụng</div>
            <div class="fs-2 fw-bold">{{ totalItems }}</div>
            <i class="fa-solid fa-boxes-stacked position-absolute top-0 end-0 m-3 opacity-50 fs-3"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3" style="background: linear-gradient(135deg,#36b9cc,#2a96a5);">
            <div class="small">Tổng số lượng tồn</div>
            <div class="fs-2 fw-bold">{{ totalQuantity }}</div>
            <i class="fa-solid fa-cubes position-absolute top-0 end-0 m-3 opacity-50 fs-3"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3" style="background: linear-gradient(135deg,#e74a3b,#c8392a);">
            <div class="small">Vật dụng sắp hết</div>
            <div class="fs-2 fw-bold">{{ lowStockItems|length }}</div>
            <i class="fa-solid fa-triangle-exclamation position-absolute top-0 end-0 m-3 opacity-50 fs-3"></i>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="card p-3">
            <h6 class="mb-3">Số lượng vật dụng theo từng kho</h6>
            <canvas id="warehouseChart" height="120"></canvas>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card p-3">
            <h6 class="mb-3 text-danger"><i class="fa-solid fa-triangle-exclamation"></i> Cảnh báo sắp hết hàng</h6>
            {% if lowStockItems|length == 0 %}
                <p class="text-muted mb-0">Không có vật dụng nào sắp hết.</p>
            {% else %}
            <table class="table table-sm">
                <thead><tr><th>Tên</th><th>Tồn</th><th>Ngưỡng</th></tr></thead>
                <tbody>
                {% for it in lowStockItems %}
                    <tr>
                        <td><a href="/items/{{ it.id }}" class="text-decoration-none">{{ it.name }}</a></td>
                        <td><span class="badge bg-danger">{{ it.quantity }}</span></td>
                        <td>{{ it.min_stock }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
const ctx = document.getElementById('warehouseChart');
new Chart(ctx, {
    type: 'bar',
    data: {
        labels: {{ chartLabels|json_encode|raw }},
        datasets: [{
            label: 'Số lượng',
            data: {{ chartQuantities|json_encode|raw }},
            backgroundColor: '#4e73df',
            borderRadius: 6,
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
            y: { beginAtZero: true },
            x: {
                ticks: {
                    minRotation: 90,
                    maxRotation: 90,
                    autoSkip: false
                }
            }
        }
    }
});
</script>
{% endblock %}
