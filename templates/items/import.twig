{% extends "layout.twig" %}
{% block title %}Import Excel - Vật dụng{% endblock %}
{% block content %}
<a href="/items" class="text-muted text-decoration-none small"><i class="fa-solid fa-arrow-left me-1"></i>Danh sách vật dụng</a>
<h3 class="mb-3 mt-1">Import vật dụng từ Excel</h3>

<div class="card p-4" style="max-width: 600px;">
    {% if error %}
        <div class="alert alert-danger">Có lỗi khi tải file lên, vui lòng thử lại.</div>
    {% endif %}
    <p class="text-muted">
        File Excel (.xlsx) cần các cột đúng thứ tự:
        <strong>Tên vật dụng, SKU, Kho, Số lượng, Đơn vị, Ngưỡng tối thiểu, Đơn giá</strong> — dòng đầu là tiêu đề, sẽ bị bỏ qua.
        Cột "Kho" ghi đúng tên kho đã có trong hệ thống để tự động gán.
    </p>
    <form method="post" action="/items/import" enctype="multipart/form-data">
        <div class="mb-3"><input type="file" name="file" accept=".xlsx" class="form-control" required></div>
        <button class="btn btn-primary"><i class="fa-solid fa-file-import"></i> Import</button>
        <a href="/items" class="btn btn-light">Huỷ</a>
    </form>
</div>
{% endblock %}