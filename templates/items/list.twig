{% extends "layout.twig" %}
{% block title %}Vật dụng{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Danh sách vật dụng</h3>
    <a href="/items/create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Thêm vật dụng</a>
</div>

<div class="card p-3 mb-3">
    <form method="get" class="row g-2">
        <div class="col-auto">
            <input type="text" name="q" class="form-control" placeholder="Tìm theo tên hoặc SKU..." value="{{ search }}">
        </div>
        <div class="col-auto">
            <select name="warehouse_id" class="form-select" onchange="this.form.submit()">
                <option value="">-- Tất cả kho --</option>
                {% for w in warehouses %}
                    <option value="{{ w.id }}" {{ selectedWarehouse == w.id ? 'selected' : '' }}>{{ w.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-magnifying-glass"></i> Tìm</button>
            {% if search or selectedWarehouse %}
                <a href="/items" class="btn btn-outline-secondary">Xoá lọc</a>
            {% endif %}
        </div>
    </form>
</div>

<div class="card p-3">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Tên vật dụng</th><th>SKU</th><th>Kho</th><th>Số lượng</th><th>Đơn vị</th><th>Ngưỡng tối thiểu</th><th>Đơn giá</th><th class="text-end">Hành động</th>
            </tr>
        </thead>
        <tbody>
        {% for it in items %}
            <tr class="{{ it.quantity <= it.min_stock ? 'table-danger' : '' }}">
                <td><a href="/items/{{ it.id }}" class="text-decoration-none fw-semibold">{{ it.name }}</a></td>
                <td>{{ it.sku }}</td>
                <td>{{ warehouseMap[it.warehouse_id] ?? '—' }}</td>
                <td>{{ it.quantity }}</td>
                <td>{{ it.unit }}</td>
                <td>{{ it.min_stock }}</td>
                <td>{{ it.price|number_format(0, ',', '.') }} đ</td>
                <td class="text-end">
                    <a href="/items/{{ it.id }}" class="btn btn-sm btn-outline-secondary">Xem</a>
                    <a href="/items/{{ it.id }}/edit" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form action="/items/{{ it.id }}/delete" method="post" class="d-inline" onsubmit="return confirm('Xoá vật dụng này?');">
                        <button class="btn btn-sm btn-outline-danger">Xoá</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="8" class="text-center text-muted">Chưa có vật dụng nào.</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {% if totalPages > 1 %}
    <nav class="mt-3">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
                <a class="page-link" href="?page={{ page - 1 }}{{ search ? '&q=' ~ search : '' }}{{ selectedWarehouse ? '&warehouse_id=' ~ selectedWarehouse : '' }}">Trước</a>
            </li>
            {% for p in 1..totalPages %}
                <li class="page-item {{ p == page ? 'active' : '' }}">
                    <a class="page-link" href="?page={{ p }}{{ search ? '&q=' ~ search : '' }}{{ selectedWarehouse ? '&warehouse_id=' ~ selectedWarehouse : '' }}">{{ p }}</a>
                </li>
            {% endfor %}
            <li class="page-item {{ page >= totalPages ? 'disabled' : '' }}">
                <a class="page-link" href="?page={{ page + 1 }}{{ search ? '&q=' ~ search : '' }}{{ selectedWarehouse ? '&warehouse_id=' ~ selectedWarehouse : '' }}">Sau</a>
            </li>
        </ul>
    </nav>
    {% endif %}
</div>
{% endblock %}
