<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Quản lý kho{% endblock %} - Warehouse Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; }
        .sidebar {
            min-height: 100vh;
            background: #1e2a3a;
        }
        .sidebar a {
            color: #cfd8e3;
            text-decoration: none;
            display: block;
            padding: 12px 20px;
            border-radius: 6px;
            margin: 2px 10px;
        }
        .sidebar a:hover, .sidebar a.active {
            background: #33475b;
            color: #fff;
        }
        .brand {
            color: #fff;
            font-weight: 700;
            padding: 20px;
            font-size: 1.2rem;
        }
        .stat-card {
            border: none;
            border-radius: 12px;
            color: #fff;
        }
        .card { border-radius: 12px; }
        .table thead { background: #eef1f5; }
    </style>
</head>
<body>
<div class="d-flex">
    <div class="sidebar" style="width: 240px;">
        <div class="brand"><i class="fa-solid fa-warehouse"></i> Kho Vật Tư</div>
        <nav>
            <a href="/dashboard"><i class="fa-solid fa-chart-line me-2"></i>Dashboard</a>
            <a href="/warehouses"><i class="fa-solid fa-building me-2"></i>Nhà kho</a>
            <a href="/items"><i class="fa-solid fa-boxes-stacked me-2"></i>Vật dụng</a>
        </nav>
    </div>
    <div class="flex-fill p-4">
        {% block content %}{% endblock %}
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
