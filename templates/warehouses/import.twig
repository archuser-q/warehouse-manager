{% extends "layout.twig" %}
{% block title %}Import Excel - Nhà kho{% endblock %}
{% block content %}
<a href="/warehouses" class="text-muted text-decoration-none small"><i class="fa-solid fa-arrow-left me-1"></i>Danh sách nhà kho</a>
<h3 class="mb-3 mt-1">Import nhà kho từ Excel</h3>
<div class="card p-4" style="max-width: 600px;">
    {% if error %}<div class="alert alert-danger">Có lỗi khi tải file lên, vui lòng thử lại.</div>{% endif %}
    <p class="text-muted">File Excel (.xlsx) cần các cột: <strong>Tên kho, Vị trí, Mô tả</strong> — dòng đầu là tiêu đề, sẽ bị bỏ qua.</p>
    <form method="post" action="/warehouses/import" enctype="multipart/form-data">
        <div class="mb-3"><input type="file" name="file" accept=".xlsx" class="form-control" required></div>
        <button class="btn btn-primary"><i class="fa-solid fa-file-import"></i> Import</button>
        <a href="/warehouses" class="btn btn-light">Huỷ</a>
    </form>
</div>
{% endblock %}