{% extends "layout.twig" %}
{% block title %}Nhà kho{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Danh sách nhà kho</h3>
    <a href="/warehouses/create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Thêm kho</a>
</div>

<div class="card p-3 mb-3">
    <form method="get" class="row g-2">
        <div class="col-auto">
            <input type="text" name="q" class="form-control" placeholder="Tìm theo tên hoặc vị trí..." value="{{ search }}">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-magnifying-glass"></i> Tìm</button>
            {% if search %}
                <a href="/warehouses" class="btn btn-outline-secondary">Xoá lọc</a>
            {% endif %}
        </div>
    </form>
</div>

<div class="card p-3">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Tên kho</th><th>Vị trí</th><th>Mô tả</th><th class="text-end">Hành động</th></tr>
        </thead>
        <tbody>
        {% for w in warehouses %}
            <tr>
                <td><a href="/warehouses/{{ w.id }}" class="text-decoration-none fw-semibold">{{ w.name }}</a></td>
                <td>{{ w.location }}</td>
                <td>{{ w.description }}</td>
                <td class="text-end">
                    <a href="/warehouses/{{ w.id }}" class="btn btn-sm btn-outline-secondary">Xem</a>
                    <a href="/warehouses/{{ w.id }}/edit" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form action="/warehouses/{{ w.id }}/delete" method="post" class="d-inline" onsubmit="return confirm('Xoá kho này và toàn bộ vật dụng trong kho?');">
                        <button class="btn btn-sm btn-outline-danger">Xoá</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="text-center text-muted">Chưa có nhà kho nào.</td></tr>
        {% endfor %}
        </tbody>
    </table>
    {% if totalPages > 1 %}
    <nav class="mt-3">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
                <a class="page-link" href="?page={{ page - 1 }}{{ search ? '&q=' ~ search : '' }}">Trước</a>
            </li>
            {% for p in 1..totalPages %}
                <li class="page-item {{ p == page ? 'active' : '' }}">
                    <a class="page-link" href="?page={{ p }}{{ search ? '&q=' ~ search : '' }}">{{ p }}</a>
                </li>
            {% endfor %}
            <li class="page-item {{ page >= totalPages ? 'disabled' : '' }}">
                <a class="page-link" href="?page={{ page + 1 }}{{ search ? '&q=' ~ search : '' }}">Sau</a>
            </li>
        </ul>
    </nav>
    {% endif %}
</div>
{% endblock %}
