{% extends "layout.twig" %}
{% block title %}{{ warehouse.name }}{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a href="/warehouses" class="text-muted text-decoration-none small"><i class="fa-solid fa-arrow-left me-1"></i>Danh sách nhà kho</a>
        <h3 class="mb-0">{{ warehouse.name }}</h3>
    </div>
    <div>
        <a href="/warehouses/{{ warehouse.id }}/edit" class="btn btn-outline-primary"><i class="fa-solid fa-pen"></i> Sửa</a>
        <form action="/warehouses/{{ warehouse.id }}/delete" method="post" class="d-inline" onsubmit="return confirm('Xoá kho này và toàn bộ vật dụng trong kho?');">
            <button class="btn btn-outline-danger"><i class="fa-solid fa-trash"></i> Xoá</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-8">
        <div class="card p-3">
            <h6 class="mb-3">Thông tin nhà kho</h6>
            <table class="table table-sm table-borderless mb-0">
                <tr><th style="width:160px;">Vị trí</th><td>{{ warehouse.location ?: '—' }}</td></tr>
                <tr><th>Mô tả</th><td>{{ warehouse.description ?: '—' }}</td></tr>
            </table>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card p-3 h-100 justify-content-center" style="background: linear-gradient(135deg,#4e73df,#3a5ecf);">
            <div class="small">Số loại vật dụng</div>
            <div class="fs-2 fw-bold">{{ totalItems }}</div>
            <div class="small mt-2">Tổng số lượng tồn: {{ totalQuantity }}</div>
        </div>
    </div>
</div>

<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">Vật dụng trong kho này</h6>
        <a href="/items/create" class="btn btn-sm btn-primary"><i class="fa-solid fa-plus"></i> Thêm vật dụng</a>
    </div>
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Tên vật dụng</th><th>SKU</th><th>Số lượng</th><th>Đơn vị</th><th>Ngưỡng tối thiểu</th><th>Đơn giá</th><th class="text-end">Hành động</th>
            </tr>
        </thead>
        <tbody>
        {% for it in items %}
            <tr class="{{ it.quantity <= it.min_stock ? 'table-danger' : '' }}">
                <td><a href="/items/{{ it.id }}" class="text-decoration-none fw-semibold">{{ it.name }}</a></td>
                <td>{{ it.sku }}</td>
                <td>{{ it.quantity }}</td>
                <td>{{ it.unit }}</td>
                <td>{{ it.min_stock }}</td>
                <td>{{ it.price|number_format(0, ',', '.') }} đ</td>
                <td class="text-end">
                    <a href="/items/{{ it.id }}" class="btn btn-sm btn-outline-secondary">Xem</a>
                    <a href="/items/{{ it.id }}/edit" class="btn btn-sm btn-outline-primary">Sửa</a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7" class="text-center text-muted">Kho này chưa có vật dụng nào.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
